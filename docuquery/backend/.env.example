# ---- Product edition: basic | professional | enterprise ----
EDITION=enterprise
ENVIRONMENT=local

# ---- LLM (any OpenAI-compatible endpoint) ----
# Local Ollama (default, keyless):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
# Cloud examples (swap 3 lines):
#   Z.ai:    https://api.z.ai/api/paas/v4  + your key + glm-4.6
#   OpenAI:  https://api.openai.com/v1    + your key + gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Cost analytics (USD per 1k tokens; 0 for free local models)
LLM_COST_PROMPT_PER_1K=0.0
LLM_COST_COMPLETION_PER_1K=0.0

# ---- Embeddings (OpenAI-compatible; must match EMBED_DIM) ----
EMBEDDINGS_BASE_URL=http://localhost:11434/v1
EMBEDDINGS_API_KEY=ollama
EMBEDDINGS_MODEL=nomic-embed-text
EMBED_DIM=768

# ---- Infrastructure ----
DATABASE_URL=postgresql+psycopg://docuquery:docuquery@localhost:5433/docuquery
REDIS_URL=redis://localhost:6379/0
USE_CELERY=False

# ---- Ingestion / chunking ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
OCR_DPI=200
OCR_MIN_CHARS_PER_PAGE=32
MAX_PDF_PAGES=500

# Office/HTML ingestion guards (OOXML files are ZIP containers: reject zip bombs)
MAX_UNCOMPRESSED_MB=200
MAX_ARCHIVE_ENTRIES=2000
XLSX_ROWS_PER_SECTION=50

# ---- URL import (POST /api/documents/url) ----
URL_IMPORT_ENABLED=True
URL_FETCH_TIMEOUT_SECONDS=20

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
REFRESH_TOKEN_EXPIRES_DAYS=30
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Emails registered under these addresses get the admin role (enterprise).
ADMIN_EMAILS=["admin@example.com"]

# ---- Rate limiting (requests per 60s window, per identity) ----
RATE_LIMIT_AUTH=10
RATE_LIMIT_CHAT=30
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_SEARCH=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Quotas (0 = unlimited; professional edition enforces) ----
MAX_DAILY_QUESTIONS=0
MAX_UPLOADS_PER_DAY=0

# ---- Semantic answer cache (professional: cost optimization) ----
CACHE_ENABLED=True
CACHE_TTL_MINUTES=60
CACHE_SIMILARITY_THRESHOLD=0.92

# ---- Audit retention (0 = keep forever) ----
AUDIT_RETENTION_DAYS=0
