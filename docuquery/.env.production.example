# Copy privately to .env.production; never commit populated values.
DATABASE_URL=postgresql+psycopg://RUNTIME_USER:PASSWORD@HOST:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_USER:PASSWORD@HOST:5432/postgres?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379/0
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CORS_ORIGINS=["https://YOUR_DEMO_DOMAIN"]
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=SET_IN_PRIVATE_ENVIRONMENT
SUPABASE_STORAGE_BUCKET=documents
LLM_BASE_URL=https://YOUR_PROVIDER/v1
LLM_API_KEY=SET_IN_PRIVATE_ENVIRONMENT
LLM_MODEL=YOUR_MODEL
EMBEDDINGS_BASE_URL=https://YOUR_PROVIDER/v1
EMBEDDINGS_API_KEY=SET_IN_PRIVATE_ENVIRONMENT
EMBEDDINGS_MODEL=YOUR_768_DIMENSION_MODEL
EMBED_DIM=768
